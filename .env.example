# Copy with: python scripts/bootstrap_env.py   (generates fresh secrets into .env)
# Never commit .env. Staging/production secrets live in GitHub Environments / secret manager.

RSV_ENV=local                      # local | test | staging | production
RSV_LOG_LEVEL=INFO
RSV_PUBLIC_BASE_URL=http://localhost:8080

# Secrets (bootstrap_env.py fills these; app refuses weak values outside local/test)
RSV_SECRET_KEY=
RSV_FIELD_ENCRYPTION_KEY=

# PostgreSQL
POSTGRES_USER=rsv
POSTGRES_PASSWORD=
POSTGRES_DB=rsv
RSV_DATABASE_URL=postgresql+asyncpg://rsv:CHANGE_ME@db:5432/rsv
RSV_DB_PGBOUNCER=false             # true disables asyncpg statement cache (ADR 0002)

# Redis
RSV_REDIS_URL=redis://redis:6379/0

# AI provider: none | cloudflare | anthropic   (ADR 0009)
RSV_AI_PROVIDER=none
RSV_CLOUDFLARE_ACCOUNT_ID=
RSV_CLOUDFLARE_AI_TOKEN=
RSV_ANTHROPIC_API_KEY=

# Payments (empty = local sandbox; required in staging/production)
RSV_RAZORPAY_KEY_ID=
RSV_RAZORPAY_KEY_SECRET=
RSV_RAZORPAY_WEBHOOK_SECRET=

# Calls. Local dev server: ws://localhost:7880 with devkey/secret
RSV_LIVEKIT_URL=ws://localhost:7880
RSV_LIVEKIT_API_KEY=devkey
RSV_LIVEKIT_API_SECRET=secret
# Change all three (and RSV_LIVEKIT_URL) if 7880-7882 are taken on your machine
RSV_LIVEKIT_PORT=7880
RSV_LIVEKIT_TCP_PORT=7881
RSV_LIVEKIT_UDP_PORT=7882

# Host port for the gateway (change if 8080 is taken on your machine)
RSV_HTTP_PORT=8080

# Object storage. Locally SeaweedFS behind the gateway; in staging/production Cloudflare R2.
RSV_S3_ENDPOINT=http://objectstore:8333
RSV_S3_PRESIGN_ENDPOINT=http://localhost:8080
RSV_MEDIA_PUBLIC_BASE=http://localhost:8080/rsv-public
RSV_PUBLIC_BASE_URL=http://localhost:8080
